<ResourceDictionary
 x:Class="DockingScene.App.MdiContextResources"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:DockingScene.Mvvm">
 <DataTemplate x:Key="EditableCaption" x:DataType="vm:DockWindowViewModel">
  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
   <TextBox Loaded="NoteLoaded" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Width="80" Height="20" MinHeight="0" FontSize="11" Padding="3,0,3,0" VerticalContentAlignment="Center" />
   <ToggleButton Loaded="TrackLoaded" Content="Track" Width="46" Height="20" MinWidth="0" MinHeight="0" FontSize="11" Padding="3,0,3,0" />
  </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="StatusCaption" x:DataType="vm:DockWindowViewModel">
  <Border Padding="5,1" CornerRadius="2">
   <TextBlock Loaded="StatusLoaded" Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" />
  </Border>
 </DataTemplate>
 <DataTemplate x:Key="ReentrantCaption">
  <Border DataContextChanged="ProbeDataChanged" Loaded="ProbeLoaded">
   <TextBlock Text="Provisional context" />
  </Border>
 </DataTemplate>
</ResourceDictionary>
